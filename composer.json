{
    "name": "dbravoan/dbcms-theme-db-brutalist",
    "type": "dbcms-theme",
    "description": "Estética neo-brutalista audaz con bordes gruesos negros, sombras duras desplazadas, colores pop saturados y tipografía tipográfica rotunda.",
    "license": "MIT",
    "require": {
        "dbravoan/dbcms-core": "~0.0.1"
    },
    "extra": {
        "dbcms": {
            "identifier": "db-brutalist",
            "repository": "https://github.com/dbravoan/dbcms-theme-db-brutalist",
            "name": "dbCMS Brutalist (Neo-Brutalism Pop)"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "fixture:lock": "@php tooling/package.php fixture:lock",
        "prepare": "@php tooling/package.php prepare",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/tests.php",
            "@php tooling/package.php test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php check"
        ],
        "test:dist": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php test:dist"
        ],
        "test:tooling": "@php tooling/tests.php",
        "profiles": "@php tooling/package.php profiles"
    },
    "archive": {
        "exclude": [
            "/.build",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/tests",
            "/tooling",
            "/docker",
            "/docs",
            "/AGENTS.md",
            "/compose.yaml",
            "/pint.json",
            "/phpunit.xml",
            "/.node-version",
            "/.dockerignore",
            "/.env",
            "/.env.*",
            "/node_modules",
            "/vendor"
        ]
    },
    "suggest": {
        "dbravoan/dbcms-module-blog": "Vistas opcionales de Blog, compatible con 0.0.x.",
        "dbravoan/dbcms-module-gallery": "Vistas opcionales de Gallery, compatible con 0.0.x.",
        "dbravoan/dbcms-module-popups": "Overlays opcionales, compatible con 0.0.x."
    }
}
